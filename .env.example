# Copy to .env and fill in. Never commit the real .env (gitignored).
# The scanner needs no secrets. These are for the dashboard and AI features.

# Supabase: dashboard accounts and per-org isolation (Project Settings > API).
# The anon key is safe to expose; RLS filters every request made with it.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Never set the service-role key here. It bypasses RLS, the dashboard does not
# use it, and the server warns at startup if it finds one.
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe billing (test mode). Used only by the cloudnova-billing webhook,
# never by the dashboard.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=   # billing webhook only

# AI features
ANTHROPIC_API_KEY=

# Live cloud scanning: prefer a real credential provider over pasting keys.
AWS_REGION=us-east-1

# Slack drift alerts
# CLOUDNOVA_SLACK_WEBHOOK=
