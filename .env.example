# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# CloudNova's scanner needs no secrets; these are for the dashboard and AI.

# --- Floatly Platform (Supabase): accounts + per-organization isolation ---
# Required to run the dashboard multi-tenant, and to bind a public interface.
# The anon/publishable key is safe to expose — it carries no authority of its
# own, because every request made with it is still filtered by Row-Level
# Security. Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Do NOT set the service-role key here. It bypasses RLS entirely, the dashboard
# never uses it, and the server warns at startup if it finds one.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe billing (test mode) ---
# Only the billing webhook process (`cloudnova-billing`) needs these. Keep them
# OUT of the dashboard's environment: the service-role key below bypasses RLS,
# which is exactly why the webhook runs as its own service.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=   # billing webhook ONLY, never the dashboard

# --- AI agents ---
ANTHROPIC_API_KEY=

# --- Live cloud scanning: prefer a real credential provider (env vars, SSO, or
# an assumed read-only role) over pasting keys here. ---
AWS_REGION=us-east-1

# --- Drift alerting ---
# CLOUDNOVA_SLACK_WEBHOOK=
